[Unit]
Description=Cisco ACI MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aci-mcp
Group=aci-mcp
WorkingDirectory=/opt/mcp_server_cisco_aci/scripts
EnvironmentFile=/opt/mcp_server_cisco_aci/scripts/.env
ExecStart=/usr/bin/python3 /opt/mcp_server_cisco_aci/scripts/server.py sse --host 0.0.0.0 --port 8001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target